# ─── App ───────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
WEB_URL=http://localhost:5173
API_URL=http://localhost:3001

# ─── PostgreSQL ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox?schema=public

# ─── Redis (BullMQ + rate limiting) ────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Elasticsearch ─────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ─── Queue / worker ────────────────────────────────────────────────────────
EMAIL_QUEUE_CONCURRENCY=5
SENDER_DEFAULT_HOURLY_LIMIT=100
SENDER_DEFAULT_MIN_DELAY_MS=1000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Google OAuth (configure later) ────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# ─── Slack OAuth (configure later) ─────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=http://localhost:3001/auth/slack/callback

# ─── Session / JWT ─────────────────────────────────────────────────────────
SESSION_SECRET=change-me-in-production-use-long-random-string
JWT_SECRET=change-me-in-production-use-long-random-string

# ─── Ethereal SMTP ─────────────────────────────────────────────────────────
# Leave user/pass empty to auto-create a test account on API startup (dev).
ETHEREAL_USER=
ETHEREAL_PASS=
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_FROM=

# Dev placeholder user until Google/Slack OAuth is wired
DEV_SCHEDULER_USER_EMAIL=scheduler@reachinbox.local

# ─── Bull Board ────────────────────────────────────────────────────────────
BULL_BOARD_PATH=/admin/queues
