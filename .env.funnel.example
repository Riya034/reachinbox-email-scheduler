# Copy to `.env.funnel` (never commit). Isolated from dev `.env` and compose.funnel volumes.
#
# 1. Run: tailscale status --json  (note your Funnel-capable HTTPS hostname, e.g. my-pc.tail1234.ts.net)
# 2. Set PUBLIC_BASE_URL below to https://YOUR-HOSTNAME (no trailing slash)
# 3. Register OAuth redirect URIs using the same host (see docs/TAILSCALE-FUNNEL.md)

PUBLIC_BASE_URL=https://YOUR-MACHINE.tailXXXX.ts.net

POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=generate-a-long-random-password
POSTGRES_DB=reachinbox_funnel

NODE_ENV=production
API_PORT=3001
WEB_URL=https://YOUR-MACHINE.tailXXXX.ts.net
API_URL=https://YOUR-MACHINE.tailXXXX.ts.net

DATABASE_URL=postgresql://reachinbox:generate-a-long-random-password@postgres:5432/reachinbox_funnel?schema=public
REDIS_URL=redis://redis:6379
ELASTICSEARCH_URL=http://elasticsearch:9200

EMAIL_QUEUE_CONCURRENCY=5
SENDER_DEFAULT_HOURLY_LIMIT=100
SENDER_DEFAULT_MIN_DELAY_MS=1000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://YOUR-MACHINE.tailXXXX.ts.net/api/auth/google/callback

SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_CALLBACK_URL=https://YOUR-MACHINE.tailXXXX.ts.net/auth/slack/callback

SESSION_SECRET=generate-a-unique-session-secret-at-least-32-characters
TOKEN_ENCRYPTION_KEY=generate-a-unique-token-encryption-key-at-least-32-chars
COOKIE_SECURE=true
INTEGRATION_TEST_AUTH_SECRET=

BULL_BOARD_PATH=/admin/queues
BULL_BOARD_REQUIRE_AUTH=true

ETHEREAL_USER=
ETHEREAL_PASS=
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_FROM=

DEV_SCHEDULER_USER_EMAIL=scheduler@reachinbox.local
