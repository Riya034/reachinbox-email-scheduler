# Copy to `.env.production` on the VPS (never commit). All values are placeholders.
# Used by compose.prod.yml via `env_file` on api and worker.

# ─── Public site (must match DNS and Caddy) ────────────────────────────────
PUBLIC_HOSTNAME=app.YOURDOMAIN.com
CADDY_ADMIN_EMAIL=you@YOURDOMAIN.com

# ─── App ───────────────────────────────────────────────────────────────────
NODE_ENV=production
API_PORT=3001
WEB_URL=https://app.YOURDOMAIN.com
API_URL=https://app.YOURDOMAIN.com

# ─── PostgreSQL (compose service `postgres`; fresh DB on first deploy) ─────
POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=generate-a-long-random-password
POSTGRES_DB=reachinbox
DATABASE_URL=postgresql://reachinbox:generate-a-long-random-password@postgres:5432/reachinbox?schema=public

# ─── Redis / Elasticsearch (internal Docker DNS) ───────────────────────────
REDIS_URL=redis://redis:6379
ELASTICSEARCH_URL=http://elasticsearch:9200

# ─── Queue / rate limits ───────────────────────────────────────────────────
EMAIL_QUEUE_CONCURRENCY=5
SENDER_DEFAULT_HOURLY_LIMIT=100
SENDER_DEFAULT_MIN_DELAY_MS=1000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Google OAuth (Google Cloud Console redirect must match exactly) ───────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://app.YOURDOMAIN.com/api/auth/google/callback

# ─── Slack OAuth (Slack app redirect must match exactly) ───────────────────
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_CALLBACK_URL=https://app.YOURDOMAIN.com/auth/slack/callback

# ─── Session & encryption (generate unique random strings, 32+ chars) ─────
SESSION_SECRET=generate-a-unique-session-secret-at-least-32-characters
TOKEN_ENCRYPTION_KEY=generate-a-unique-token-encryption-key-at-least-32-chars
COOKIE_SECURE=true

# Leave unset in production (disables integration test auth bypass)
INTEGRATION_TEST_AUTH_SECRET=

# ─── Bull Board ────────────────────────────────────────────────────────────
BULL_BOARD_PATH=/admin/queues
BULL_BOARD_REQUIRE_AUTH=true

# ─── Ethereal SMTP (outbound TCP 587 from VPS must reach smtp.ethereal.email) ─
# Option A: set both for a fixed Ethereal mailbox you create at https://ethereal.email
# Option B: leave empty — API creates a mailbox on first Google login (stored encrypted in Postgres)
ETHEREAL_USER=
ETHEREAL_PASS=
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_FROM=

# Placeholder dev user row (not used for reviewer login when Google OAuth is configured)
DEV_SCHEDULER_USER_EMAIL=scheduler@reachinbox.local
